{
  "name": "@agnap/access-types",
  "version": "0.1.0",
  "description": "Built-in GNAP access types, including agent_operation coverage and containment.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent-operation": {
      "development": "./src/agent-operation.ts",
      "types": "./dist/agent-operation.d.ts",
      "default": "./dist/agent-operation.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agnap/gnap-core": "workspace:*"
  }
}

{
  "name": "@agnap/gnap-server",
  "version": "0.1.0",
  "description": "An RFC-conformant GNAP authorization server profile: grant, continuation, token revocation, RFC 9767 introspection. Fetch handler, no framework, Node runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agnap/access-types": "workspace:*",
    "@agnap/gnap-core": "workspace:*"
  },
  "bin": {
    "gnap-server": "./dist/cli.js"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
